# =============================================================================
# AIZU (Aizu) — Environment Configuration
# =============================================================================
# Copy this file to `.env` and fill in the values you need:
#     cp .env.example .env
#
# Only OPENROUTER_API_KEY is required to run the engine. Everything else has a
# sensible default or is only needed for a specific platform / feature.
# Never commit your real `.env` — keep secrets out of version control.
# =============================================================================


# -----------------------------------------------------------------------------
# LLM / OpenRouter (REQUIRED)
# -----------------------------------------------------------------------------
# API key for OpenRouter — powers all AI reasoning, matching, and generation.
OPENROUTER_API_KEY=

# Text + vision model overrides. NOT optional in practice right now: the
# in-code defaults are stale (see memory/known-issues.md C0 — both were absent
# from OpenRouter's live model listing when last checked, 2026-08-21), so a box
# without these two set sends a model id OpenRouter does not have.
#
# The ids below were verified present against GET https://openrouter.ai/api/v1/models
# on 2026-08-21 with the per-1M prices shown. A model id is a third-party fact
# with a shelf life — re-check before trusting it.
#   qwen/qwen3-vl-32b-instruct    in $0.104 / out $0.416  text+image, 131k ctx
#   google/gemini-3.5-flash-lite  in $0.300 / out $2.500  1.05M ctx
#   nex-agi/nex-n2-mini           in $0.025 / out $0.100  cheapest text
OPENROUTER_TEXT_MODEL=nex-agi/nex-n2-mini
OPENROUTER_VISION_MODEL=qwen/qwen3-vl-32b-instruct

# -----------------------------------------------------------------------------
# Local-first LLM stack (optional — point the engine at a local OpenAI-compatible
# server instead of / in front of OpenRouter, mirroring soliq's local stack).
# -----------------------------------------------------------------------------
# Local endpoint (Ollama/LM Studio/vLLM). Set to the /v1 root — the engine appends
# /chat/completions. When set, a live run no longer requires OPENROUTER_API_KEY.
# e.g. http://localhost:11434/v1
AIZU_LLM_BASE_URL=
# Local model IDs (take priority over OPENROUTER_* above). One VL model serves
# both text and vision — e.g. qwen3-vl:30b-a3b-instruct for both.
AIZU_TEXT_MODEL=
AIZU_VISION_MODEL=
# Ollama context window for multi-frame vision. MUST be >= 16384 or multi-image
# requests truncate silently (soliq docs/LOCAL_AI.md). Only sent to local endpoints.
AIZU_NUM_CTX=16384
# Local-primary -> cloud-secondary fallback (soliq's FallbackProvider). Requires
# AIZU_LLM_BASE_URL + OPENROUTER_API_KEY both set. The cloud leg uses these model
# IDs (else the OPENROUTER_* defaults) so it stays independent of the local models.
AIZU_LLM_FALLBACK_ENABLED=
AIZU_LLM_FALLBACK_TEXT_MODEL=
AIZU_LLM_FALLBACK_VISION_MODEL=

# Model used specifically for AI campaign generation (optional; falls back to
# the text model above when unset).
CAMPAIGN_GEN_MODEL=

# Model comparison (optional; off unless BOTH are set — the superadmin toggle
# also gates this for in-process runs, see the admin Model Performance page).
# Comma-separated OpenRouter model IDs to run alongside OPENROUTER_TEXT_MODEL on
# every match-stage (lead) decision, purely for comparison logging — a
# comparison model's verdict never affects the lead a session actually captures.
MODEL_COMPARISON_MODELS=
# Distributed worker boxes never see the cloud superadmin toggle (their local DB
# has no platform_settings row for it) — set this locally on a worker box to opt
# it into comparison fan-out. In-process/cloud runs are governed by the panel
# toggle instead and don't need this set.
MODEL_COMPARISON_ENABLED=


# -----------------------------------------------------------------------------
# Core engine (optional — defaults shown)
# -----------------------------------------------------------------------------
# SQLite database path.
AIZU_DB=aizu.db

# Path to a config file, if you use one instead of env vars.
AIZU_CONFIG=

# Chrome DevTools Protocol endpoint for the managed browser (Instagram/X/etc).
# 9333 is canonical (ledger F10) and matches scripts/warm_chrome.sh and the desktop shell.
# NOTE: setting AIZU_CDP_URL at all counts as an EXPLICIT operator pin, which disarms the
# worker preflight's auto-adoption of the other well-known port — leave it commented out
# unless you really do run Chrome somewhere else. That is why the line below stays
# commented (it used to ship live, so every box provisioned by copying this file lost
# auto-adoption — the boxes that follow the setup guide are exactly the ones that need
# it), and why it must NOT be turned into a bare `AIZU_CDP_URL=` like the optional keys
# above: cli._load_env setdefault()s a blank value into os.environ, and
# WorkerConfig.from_env keys `cdp_url_explicit` off PRESENCE, not truthiness.
#AIZU_CDP_URL=http://127.0.0.1:9333
# (AIZU_CDP_PORT is read by scripts/warm_chrome.sh only — it is not an operator pin.)
AIZU_CDP_PORT=9333

# Base directory for the managed browser's profile, shared by scripts/warm_chrome.sh,
# the worker sidecar and the desktop shell. It is a BASE, not the profile: each browser
# BRAND gets its own subdirectory under it (<base>/chrome-for-testing, <base>/chrome),
# because opening one profile with the other brand DELETES every saved login in it.
# Blank = ~/.aizu-cft-profile. CHROME_BIN picks which browser; unset means Chrome for
# Testing when Playwright is installed.
AIZU_CHROME_PROFILE=
AIZU_PROFILE_ROOT=

# Hard spend cap (USD) per run before the engine aborts.
AIZU_SPEND_CAP=20.0

# Set to 1/true to bypass the daytime-only run guard (useful for testing).
AIZU_IGNORE_DAYTIME=

# Human-simulation (core/human.py): jittered scroll/nav/dwell for a human-like,
# harder-to-fingerprint browsing cadence on the CDP engines. On by default; set
# to "off" to disable (e.g. fast CI). HUMAN_SIM_SPEED scales every delay
# (0.5 = 2x faster, 2 = calmer); malformed/<=0 falls back to 1.
HUMAN_SIM=
HUMAN_SIM_SPEED=1

# Enable the account-warming subsystem. This is the GLOBAL layer-1 hard-stop
# ("warming is permitted at all"), NOT a statement about what this box does.
AIZU_WARMING_ENABLED=

# Declares that THIS box only ever runs warming jobs and never leases harvest
# work. The only thing it changes is the worker launch preflight: the LLM-backend
# check drops from fatal to warn, because a warming-only box legitimately has no
# OPENROUTER_API_KEY. Do NOT set it on a box that also leases harvest jobs — every
# live job there dies at setup and dead-letters at attempt 5, behind an amber row
# nobody reads. Deliberately separate from AIZU_WARMING_ENABLED above, which the
# preflight used to read for this and which a harvest box has every reason to set.
AIZU_WORKER_WARMING_ONLY=

# Local Uzbek STT ("KotibAI", Instagram-only, campaign-gated — see
# core/transcribe.py). This is the global hard-stop: even when a campaign sets
# enable_stt:true (and has "uz" in language_mix), nothing imports faster-whisper
# or touches the GPU unless AIZU_STT_ENABLED is ALSO set here. Requires:
#   pip install -e ".[stt]"   (faster-whisper + CUDA DLL packages on Windows)
#   ffmpeg on PATH             (external binary, not a pip dependency)
AIZU_STT_ENABLED=
AIZU_STT_MODEL_PATH=
AIZU_STT_DEVICE=cuda
AIZU_STT_COMPUTE_TYPE=float16
# Forced decode language. Default "uz" (the KotibAI fine-tune; auto-detect
# misfires on Uzbek). A general model (e.g. Systran/faster-whisper-large-v3) can
# set another language here.
AIZU_STT_LANGUAGE=uz

# Encryption key (Fernet) for per-org integration secrets at rest.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIZU_SECRET_KEY=

# Comma-separated emails granted interim platform-admin (fleet) access.
AIZU_PLATFORM_ADMINS=

# Comma-separated IPs / CIDRs allowed to reach /api/admin/*. FAILS CLOSED: unset
# means nobody can log in to the superadmin plane.
AIZU_ADMIN_IP_ALLOWLIST=

# File whose presence pauses the engine mid-run.
AIZU_PAUSE_FILE=

# Correlation id injected into a run so activity events can be traced.
AIZU_RUN_ID=


# -----------------------------------------------------------------------------
# Logging (optional — defaults shown)
# -----------------------------------------------------------------------------
AIZU_LOG_LEVEL=INFO
AIZU_LOG_FILE=
AIZU_LOG_FILE_LEVEL=
AIZU_LOG_COLOR=
# Standard NO_COLOR convention — set to disable ANSI colors everywhere.
NO_COLOR=


# -----------------------------------------------------------------------------
# Distributed workers (optional — only for the pull-model worker fleet)
# -----------------------------------------------------------------------------
# Base URL the worker calls back to for leasing jobs.
AIZU_DISPATCH_URL=
# Bearer token the worker presents on register/lease.
AIZU_WORKER_BOOTSTRAP_TOKEN=
# Local directory where the worker persists its state.
AIZU_WORKER_STATE=.worker-state
# Org id a dedicated worker is scoped to.
AIZU_ORG_ID=
# Minimum agent version the server will accept from workers.
AIZU_MIN_AGENT_VERSION=


# -----------------------------------------------------------------------------
# Telegram integration (optional — required only for the Telegram platform)
# -----------------------------------------------------------------------------
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=
TELEGRAM_SESSION=


# -----------------------------------------------------------------------------
# YouTube integration (optional — required only for the YouTube platform)
# -----------------------------------------------------------------------------
YOUTUBE_API_KEY=


# -----------------------------------------------------------------------------
# Reddit integration (optional — required only for the Reddit platform)
# -----------------------------------------------------------------------------
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# e.g. "aizu:lead-radar:v1.0 (by /u/yourname)"
REDDIT_USER_AGENT=


# -----------------------------------------------------------------------------
# Polar billing (optional — required only for subscription billing)
# -----------------------------------------------------------------------------
POLAR_ACCESS_TOKEN=
# "sandbox" (default) or "production".
POLAR_SERVER=sandbox
POLAR_WEBHOOK_SECRET=
# Comma-separated product/price mapping used to resolve tiers.
POLAR_PRODUCTS=
